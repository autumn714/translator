# =============================================================================
# Required
# =============================================================================

# Absolute host path to the gemma-4-E4B-it model directory.
# The directory must contain at minimum:
#   config.json, generation_config.json, model.safetensors,
#   processor_config.json, tokenizer.json, tokenizer_config.json
MODEL_PATH=/path/to/gemma-4-E4B-it

# =============================================================================
# Optional overrides (defaults work for most setups)
# =============================================================================

# GPU index visible to the vLLM container (default: 0)
# VLLM_GPU_DEVICE=0

# Host ports
# APP_PORT=7860
# VLLM_PORT=8001

# vLLM image tag
# VLLM_IMAGE=vllm/vllm-openai:gemma4

# CORS origins for the app (comma-separated). Leave blank for same-origin use.
# CORS_ALLOW_ORIGINS=

# =============================================================================
# Optional CTranslate2 preview backend (not used by default)
# =============================================================================
# CT2_DEVICE=cpu
# CT2_COMPUTE_TYPE=int8
# CT2_INTER_THREADS=1
# CT2_INTRA_THREADS=0
# CT2_MODEL_DIR=/path/to/preview-en-ko-ct2
# CT2_SENTENCEPIECE_MODEL=/path/to/preview-en-ko-ct2/source.spm
