# ─────────────────────────────────────────────────────────────
#  설정 파일 — 필요한 것만 고치면 된다. (bash 문법: 이름=값, 띄어쓰기 없이)
#  고친 뒤에는 bash run.sh start 를 다시 실행하면 반영된다.
#  새 판으로 업데이트할 때 이 파일은 덮어쓰지 않는다 (덮어쓰면 로그인·접속 허용 범위가 기본값으로 돌아간다).
# ─────────────────────────────────────────────────────────────

# 브라우저 접속 주소
#   UI_BIND=0.0.0.0   → 같은 내부망의 다른 PC에서 http://<서버IP>:UI_PORT 로 접속 가능
#   UI_BIND=127.0.0.1 → 서버 자신에서만 접속 가능
#   7860 은 도면 분석기가 쓰므로 번역기는 7870 을 쓴다.
UI_BIND="0.0.0.0"
UI_PORT="7870"

# 접속을 허용할 PC 주소 범위 (띄어쓰기로 여러 개). 비우면 내부망 어디서나 접속 가능
#   예: UI_ALLOW="10.1.20.0/24 10.1.21.15/32"
UI_ALLOW=""

# 화면 로그인
#   UI_AUTH="1" 이면 로그인해야 쓸 수 있다(true·yes·on 도 켬, 그 밖의 값은 끔). UI_PASSWORD 를 비워 두면 처음 시작할 때
#   임의 비밀번호를 만들어 state/ui_password 에 저장한다.
UI_AUTH="0"
UI_USER="translator"
UI_PASSWORD=""

# 모델 서버 — 도면 분석기가 띄운 vLLM 컨테이너를 같이 쓴다 (GPU 메모리를 더 쓰지 않음)
#   LLM_CONTAINER : 도면 분석기의 모델 서버 컨테이너 이름
#   LLM_PORT      : 그 컨테이너 안의 포트
#   LLM_MODEL     : 비우면 모델 서버가 알려 주는 이름을 자동으로 쓴다
LLM_CONTAINER="pfdvlm-vllm"
LLM_PORT="8000"
LLM_MODEL=""

# 다른 곳의 OpenAI 호환 모델 서버를 쓸 때만 (예: http://10.x.x.x:8000/v1)
#   적으면 도면 분석기 컨테이너에 연결하지 않고, 번역기 화면 컨테이너가 일반 네트워크에도 붙는다(격리 약해짐).
LLM_URL=""
LLM_API_KEY="EMPTY"

# 모델 서버 동시 요청 한도 — 도면 분석기와 함께 쓰는 서버의 동시 처리 한도는 8 이다.
#   LLM_MAX_PARALLEL : 번역기 전체가 한꺼번에 보내는 요청 수
#   LLM_DOC_PARALLEL : 그중 문서 번역이 쓸 수 있는 수 (텍스트 번역이 항상 먼저 처리된다)
LLM_MAX_PARALLEL="3"
LLM_DOC_PARALLEL="2"

# 문서 번역
#   DOC_MAX_MB          : 올릴 수 있는 파일 크기 (MB)
#   DOC_RETENTION_HOURS : 올린 문서와 번역본을 지우기까지의 시간 (번역기가 켜져 있는 동안 지운다)
#   DOC_JOB_CONCURRENCY : 한꺼번에 처리하는 문서 수
#   DOC_DISK_QUOTA_MB   : 올린 문서와 번역본(data/jobs)이 쓸 수 있는 디스크 용량 (MB). 다 차면 새 문서를 받지 않는다
DOC_MAX_MB="50"
DOC_RETENTION_HOURS="24"
DOC_JOB_CONCURRENCY="2"
DOC_DISK_QUOTA_MB="2048"

# 번역기 화면 컨테이너가 쓸 수 있는 메모리 상한 (도면 분석기와 함께 쓰는 서버 메모리 보호). 예: 8g
APP_MEMORY="8g"

# 도커 내부 네트워크 주소 대역. 비우면 도커가 자동으로 고른다.
#   일부 PC에서만 접속이 안 되면, 그 PC의 주소가 도커 대역과 겹친 것이다. 기관 내부망과 겹치지 않는 대역을 적는다.
#   도면 분석기와 다른 대역이어야 한다. 예: NET_INT_SUBNET="10.250.252.0/28"  NET_PUB_SUBNET="10.250.253.0/28"
NET_INT_SUBNET=""
NET_PUB_SUBNET=""

# setup 때 인터넷이 프록시를 거쳐야 하는 경우만 (예: http://proxy.example.go.kr:3128). 파이썬 패키지 설치에만 쓴다
SETUP_PROXY=""
SETUP_PIP_INDEX_URL=""

# 컨테이너 시간대 (로그 시각·문서 보관 시각). KST-9 = 한국 표준시
CONTAINER_TZ="KST-9"

# 도커 이미지 (바꾸지 않아도 된다. 도면 분석기가 이미 받아 둔 이미지를 같이 쓴다)
PY_IMAGE="python:3.12-slim"

# 컨테이너·네트워크 이름 앞머리 (보통 바꿀 일 없음)
NAME_PREFIX="translator"
